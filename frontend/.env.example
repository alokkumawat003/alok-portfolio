# EmailJS public browser identifiers. Do not place private keys or mailbox credentials here.
# Service ID: EmailJS > Email Services
# Template ID: EmailJS > Email Templates (accepts user_name, user_email, message)
# Public Key: EmailJS > Account > General
# See EMAILJS_SETUP.md for local, Vercel, template, origin-restriction, and delivery-test steps.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
